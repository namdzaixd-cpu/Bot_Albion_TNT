# ==============================================================================
# FILE NÀY LÀ MẪU - SAO CHÉP THÀNH .env VÀ ĐIỀN GIÁ TRỊ THẬT VÀO
# KHÔNG BAO GIỜ COMMIT FILE .env LÊN GITHUB!
# ==============================================================================

# Token của Discord Bot (lấy từ Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# ID của Guild (server) Discord mà bot phục vụ
DISCORD_GUILD_ID=your_guild_id_here

# API Key cho Gemini (Google AI Studio), dùng cho các bước Gemini trong chuỗi dự phòng AI
# Tạo tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# API Key cho OpenRouter, dùng cho các bước OpenRouter trong chuỗi dự phòng AI (cog chat_ai)
# Tạo tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# API Key cho Ollama Cloud (ollama.com), dùng cho các bước Ollama trong chuỗi dự phòng AI
# Tùy chọn - một số endpoint Ollama không bắt buộc phải có key
# Tạo tại: https://ollama.com/settings/keys
OPENROUTER_MODEL=your_openrouter_model_here

# Connection pooling for Prisma (Transaction mode - via PgBouncer)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for Prisma Migrations (Session mode)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"


# Supabase Auth configuration
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_JWT_SECRET="your_supabase_jwt_secret_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Web Dashboard (Next.js) public environment variables
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Secret server-side giống nhau trên bot và dashboard; không dùng NEXT_PUBLIC_.
# Thiếu secret: webhook reload bị khóa, không fallback sang endpoint công khai.
WEBHOOK_SECRET=